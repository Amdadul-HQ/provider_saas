# Copy to .env (git-ignored). Values below are DEV-ONLY defaults; every one of them is
# rejected by the API when APP_ENV is anything other than development/test.
# Keep values free of inline comments (the Makefile includes this file).

# Backend
APP_ENV=development
HTTP_ADDR=:8080
# The API connects as psaas_app (no superuser, no BYPASSRLS: row-level security applies).
DATABASE_URL=postgres://psaas_app:psaas_app@localhost:5432/psaas?sslmode=disable
# Migrations run as the table owner.
MIGRATE_DATABASE_URL=postgres://psaas:psaas@localhost:5432/psaas?sslmode=disable
# Homebrew Postgres instead of docker (make db-setup):
#   DATABASE_URL=postgres://psaas_app:psaas_app@localhost:5432/psaas_dev?sslmode=disable
#   MIGRATE_DATABASE_URL=postgres://<your OS user>@localhost:5432/psaas_dev?sslmode=disable
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-32-bytes-minimum-secret-key
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
# 32-byte hex (64 chars). This dev key is shared by seed, API and worker so seeded secrets
# decrypt everywhere (QA BUG-01); production must use its own key.
VAULT_KEY=6465762d6f6e6c792d7661756c742d6b65792d646f2d6e6f742d7573652d2121
VAULT_KEY_VERSION=1
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080
UPLOAD_DIR=./uploads
META_GRAPH_VERSION=v21.0
CORS_ORIGINS=http://localhost:3000
# Comma-separated proxy networks allowed to set X-Forwarded-For (empty = trust no header).
TRUSTED_PROXY_CIDRS=
# Meta (Facebook/Instagram/WhatsApp). Empty META_APP_ID = in-memory fake client.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=change-me
# SMS forwarder: per-tenant bearer token from the rotateSmsWebhookToken mutation (docs/integrations.md)

# Frontend
# Recommended in dev: let Next proxy the API (same origin, no CORS). Use the direct URL instead
# only when the API's CORS_ORIGINS includes the web origin.
NEXT_DEV_API_PROXY=http://localhost:8080
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:3000/graphql
NEXT_PUBLIC_APP_URL=http://localhost:3000
